      {
        "name": "Send To Kobo Kindle",
        "packageName": "kora.integration.send-to-kobo-kindle",
        "resources": {
          "apkUrl": "https://raw.githubusercontent.com/CHAOTIC-RAY/Kora-Plugins/main/sources/integrations/send-to-kindle.json",
          "iconUrl": "https://github.com/CHAOTIC-RAY/Kora-Plugins/raw/main/sources/integrations/icons/send-to-kindle.png"
        },
        "extensionLib": "kora-1",
        "versionCode": "1000",
        "versionName": "1.0.0",
        "sources": [
          {
            "id": "kora-integration-kindle",
            "name": "Send to Kobo/Kindle",
            "language": "en",
            "piracy": false,
            "nsfw": false,
            "category": "integration",
            "target": "kindle",
            "availability": "unavailable",
            "availabilityNote": "NOT YET FUNCTIONAL. Uploading to a Kindle requires Amazon's KDP Personal Document Service, which is gated behind an Amazon-approved developer account. Amazon does not issue these tokens to third-party apps, and there is no user-supplied-credential path that works. This plugin therefore installs, and shows you how to use Calibre's own Send to Kindle plugin instead, but it will not claim to have sent anything. No upload is attempted and no success is ever reported.",
            "requires": [
              "permission"
            ],
            "readableCheckedAt": "2026-09-30T07:19:24.435Z",
            "description": "Send a book to your Kobo or Kindle. Three routes: upload to a Send-to-Kindle server you choose, hand off to croc, or open Amazon's official Send to Kindle page. Your own key or server address; no credentials are shipped.",
            "author": "Kora",
            "homeUrl": "https://www.amazon.com/sendtokindle"
          }
        ]
